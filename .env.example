# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never exposed to the browser. Used by API routes that must
# bypass RLS (e.g. writing ai_sessions/ai_messages, admin server actions).
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers (server-side only) ──────────────────────
# Primary provider
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback provider, used automatically if Groq fails or times out
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional future providers (abstraction already supports them; see src/lib/ai/providers.ts)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── AI safety / rate limiting ─────────────────────────────
AI_MAX_MESSAGES_PER_SESSION=30
AI_MAX_MESSAGE_LENGTH=1000
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=10

# ── Contact ───────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=967779339333

# ── Site ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://atiqaljadhwa.com
